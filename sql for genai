---
### Phase 1: Data Definition Language (DDL)
*DDL commands define, alter, and manage the structural schema of the database.*
```sql
-- 1. Create a fresh database for practice
CREATE DATABASE genai_knowledge_db;
USE genai_knowledge_db;

-- 2. Create Primary Tables (Suppliers and Products)
CREATE TABLE suppliers (
    supplier_id INT PRIMARY KEY AUTO_INCREMENT,
    supplier_name VARCHAR(100) NOT NULL,
    country VARCHAR(50) DEFAULT 'USA',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP
);

CREATE TABLE products (
    product_id INT PRIMARY KEY AUTO_INCREMENT,
    product_name VARCHAR(150) NOT NULL,
    category VARCHAR(50),
    price DECIMAL(10, 2),
    stock_quantity INT DEFAULT 0,
    supplier_id INT,
    FOREIGN KEY (supplier_id) REFERENCES suppliers(supplier_id) ON DELETE CASCADE
);

-- 3. Create Supporting Tables for LLM Application Tracking
CREATE TABLE vector_embeddings (
    embed_id INT PRIMARY KEY AUTO_INCREMENT,
    product_id INT,
    embedding_dimensions INT DEFAULT 1536, -- Standard OpenAI dimension size
    status VARCHAR(20) DEFAULT 'PENDING',
    FOREIGN KEY (product_id) REFERENCES products(product_id)
);

CREATE TABLE agent_logs (
    log_id INT PRIMARY KEY AUTO_INCREMENT,
    query_text TEXT,
    response_text TEXT,
    tokens_used INT
);

-- 4. ALTER: Modify table structure (Add/Modify/Drop columns)
ALTER TABLE products ADD COLUMN description TEXT;
ALTER TABLE agent_logs MODIFY COLUMN tokens_used BIGINT;
ALTER TABLE agent_logs RENAME COLUMN query_text TO user_prompt;

-- 5. CREATE INDEX: Optimize retrieval speeds for vector lookups and filtering
CREATE INDEX idx_product_category ON products(category);

-- 6. TRUNCATE vs DROP (Demonstration)
CREATE TABLE temp_cache (cache_id INT, cache_data VARCHAR(255));
TRUNCATE TABLE temp_cache; -- Empties rows instantly while maintaining table structure
DROP TABLE temp_cache;     -- Completely removes table and schema definition
```
