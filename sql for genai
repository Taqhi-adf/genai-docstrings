### Phase 3: Data Manipulation Language (DML) & Data Query Language (DQL)
*DML handles inserting, updating, and deleting records, while DQL (SELECT) queries data.*
```sql
-- ============================================================================
-- A. INSERTION (DML)
-- ============================================================================
INSERT INTO suppliers (supplier_name, country) 
VALUES 
('NVIDIA Tech', 'USA'),
('Logitech', 'Switzerland'),
('Anker Global', 'China');

INSERT INTO products (product_name, category, price, stock_quantity, supplier_id, description) 
VALUES 
('H100 GPU Server', 'Hardware', 29999.99, 10, 1, 'Enterprise AI acceleration unit'),
('Wireless Noise-Canceling Headphones', 'Audio', 199.99, 150, 3, 'Bluetooth over-ear headset'),
('MX Master 3S Mouse', 'Peripherals', 99.99, 200, 2, 'Ergonomics productivity mouse'),
('USB-C Fast Charger', 'Accessories', 29.99, 500, 3, '65W GaN wall adapter'),
('RTX 4090 GPU', 'Hardware', 1599.99, 0, 1, 'Consumer flagship graphics card');

-- ============================================================================
-- B. UPDATE & DELETE (DML)
-- ============================================================================
-- Update stock quantity based on category condition
UPDATE products 
SET stock_quantity = stock_quantity + 20 
WHERE category = 'Hardware';

-- Delete out-of-stock items under a specific price point
DELETE FROM products 
WHERE stock_quantity = 0 AND price < 100.00;

-- ============================================================================
-- C. QUERIES FOR GENAI & TEXT-TO-SQL PRACTICES (DQL)
-- ============================================================================

-- 1. Filter, Sort, Limit (Basic Retrieval)
SELECT product_name, price, stock_quantity 
FROM products 
WHERE price > 100.00 
ORDER BY price DESC 
LIMIT 3;

-- 2. Aggregations & Grouping (LLM Summarization Data)
SELECT 
    category,
    COUNT(*) AS total_items,
    AVG(price) AS average_price,
    SUM(stock_quantity) AS total_inventory
FROM products
GROUP BY category
HAVING AVG(price) > 50.00;

-- 3. Joins (Relational Context Assembly)
SELECT 
    p.product_id,
    p.product_name,
    p.price,
    s.supplier_name,
    s.country
FROM products p
INNER JOIN suppliers s ON p.supplier_id = s.supplier_id;

-- 4. Subqueries & CTEs (Complex Reasoning Pipelines)
WITH HighValueProducts AS (
    SELECT product_name, category, price 
    FROM products 
    WHERE price > (SELECT AVG(price) FROM products)
)
SELECT * FROM HighValueProducts WHERE category = 'Hardware';

-- 5. Conditional Expressions (CASE Statements)
SELECT 
    product_name,
    stock_quantity,
    CASE 
        WHEN stock_quantity = 0 THEN 'OUT OF STOCK'
        WHEN stock_quantity < 20 THEN 'LOW STOCK'
        ELSE 'IN STOCK'
    END AS stock_status
FROM products;

```
